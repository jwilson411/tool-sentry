{
  "tools": [
    {
      "name": "search_documents",
      "description": "Search the indexed document corpus. Returns ranked matches.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Full-text query string."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of matches to return.",
            "minimum": 1,
            "maximum": 50
          },
          "order": {
            "type": "string",
            "description": "Sort order for the returned matches.",
            "enum": ["relevance", "recency"]
          },
          "offset": {
            "type": "integer",
            "description": "Number of leading matches to skip."
          }
        },
        "required": ["query", "limit"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "score": { "type": "number" }
              }
            }
          }
        }
      }
    },
    {
      "name": "create_ticket",
      "description": "Create a tracking ticket for a follow-up task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "One-line ticket summary."
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        },
        "required": ["summary"]
      }
    }
  ]
}
