{
  "tools": [
    {
      "name": "search_documents",
      "description": "  Search the indexed document corpus. Returns ranked matches.  ",
      "inputSchema": {
        "type": "object",
        "required": ["query", "limit"],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Full-text\tquery string."
          },
          "order": {
            "type": "string",
            "enum": ["relevance", "recency", "title"],
            "description": "Sort order for results."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Maximum number of matches to return."
          }
        }
      }
    },
    {
      "name": "create_ticket",
      "description": "Create a tracking ticket for a follow-up task.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "type": "object",
            "required": ["email"],
            "properties": {
              "email": {
                "type": "string",
                "description": "Contact address for the assignee."
              }
            }
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        },
        "required": ["title", "severity"]
      }
    }
  ]
}
