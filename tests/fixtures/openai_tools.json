[
  {
    "type": "function",
    "function": {
      "name": "search_documents",
      "description": "Search the indexed document corpus.\n    Returns ranked matches.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Full-text query string."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of matches   to return.",
            "minimum": 1,
            "maximum": 50
          },
          "order": {
            "type": "string",
            "description": "Sort order for results.",
            "enum": ["relevance", "recency", "title"]
          }
        },
        "required": ["query", "limit"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_ticket",
      "description": "Create a tracking ticket for a follow-up task.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "assignee": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "description": "Contact address\n      for the assignee."
              }
            },
            "required": ["email"]
          }
        },
        "required": ["title", "severity"],
        "additionalProperties": false
      }
    }
  }
]
